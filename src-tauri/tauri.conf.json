{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "8D Studio",
  "version": "0.1.0",
  "identifier": "com.eightd.studio",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "8D Studio",
        "width": 1040,
        "height": 780,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/8d-backend"],
    "resources": ["../backend-dist/_internal"]
  },
  "plugins": {
    "shell": {
      "open": false,
      "sidecar": true
    }
  }
}
